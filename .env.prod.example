# Production settings for docker-compose.prod.yml. On the server: copy to .env.prod next to the
# Compose file, fill in, `chmod 600 .env.prod`. .env.prod is ignored by git and never goes into
# an image or a build argument. Placeholders only in this file: never put a real value here.
#
# Generate each secret with: openssl rand -hex 32
# (hex, so it is safe inside the database URL). Keep a copy of PGBACKREST_CIPHER_PASS and
# RESTIC_PASSWORD in the password manager: without them the backups cannot be read.

# --- Caddy ---------------------------------------------------------------------------------
# The app's host name. DNS must point here before the first start (Let's Encrypt).
SITE_ADDRESS=app.example.com
# Let's Encrypt account email (expiry warnings).
ACME_EMAIL=ops@example.com

# --- App -----------------------------------------------------------------------------------
APP_URL=https://app.example.com
PAYLOAD_SECRET=replace-with-openssl-rand-hex-32
# Comma-separated. Admin only for a verified email that signs in with Google.
ADMIN_EMAILS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Mailjet SMTP relay: API key as user, secret key as password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@example.com

# --- PostgreSQL ----------------------------------------------------------------------------
POSTGRES_USER=konnected
POSTGRES_DB=konnected
POSTGRES_PASSWORD=replace-with-openssl-rand-hex-32

# --- Backups (Hetzner Storage Box over SFTP) ----------------------------------------------------
# Folder on the server with id_ed25519, id_ed25519.pub and known_hosts for the Storage Box
# (see docs/production.md). Readable by PostgreSQL in its container (uid 999).
BACKUP_SSH_DIR=./backup-ssh
BACKUP_SFTP_HOST=uXXXXXX.your-storagebox.de
BACKUP_SFTP_PORT=23
BACKUP_SFTP_USER=uXXXXXX
# Absolute paths on the Storage Box. Check the folder layout after the first SFTP login.
PGBACKREST_REPO_PATH=/home/pgbackrest
RESTIC_REPO_PATH=/home/restic
PGBACKREST_CIPHER_PASS=replace-with-openssl-rand-hex-32
RESTIC_PASSWORD=replace-with-openssl-rand-hex-32

# --- Images --------------------------------------------------------------------------------
# Where deploy.sh pulls the app image from when it is given a bare commit SHA (lowercase).
IMAGE_REPO=ghcr.io/owner/konnect-webb-app
