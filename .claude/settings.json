{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.development)",
      "Read(./.env.test)",
      "Read(./.env.production)",
      "Read(./credentials/**)",
      "Edit(./.env)",
      "Edit(./credentials/**)",
      "mcp__notion",
      "mcp__notion-private"
    ],
    "ask": [
      "mcp__notion-konnect__notion-create-pages",
      "mcp__notion-konnect__notion-update-page",
      "mcp__notion-konnect__notion-delete-pages",
      "mcp__notion-konnect__notion-move-pages",
      "mcp__notion-konnect__notion-duplicate-page",
      "mcp__notion-konnect__notion-create-database",
      "mcp__notion-konnect__notion-update-data-source",
      "mcp__notion-konnect__notion-delete-databases",
      "mcp__notion-konnect__notion-create-comment",
      "mcp__notion-konnect__notion-update-view",
      "mcp__notion-konnect__notion-create-view"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-bash.sh" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format-file.sh" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/schema-check.sh" }
        ]
      }
    ]
  }
}
