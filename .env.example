# Copy to .env and edit. .env is ignored by git. Never put real secrets in this file.

# PostgreSQL. These values match docker-compose.yml (local development only).
DATABASE_URL=postgres://konnected:konnected@127.0.0.1:5433/konnected

# Payload secret. Generate your own: openssl rand -hex 32
PAYLOAD_SECRET=replace-with-a-long-random-string

# The public address of the app. Google sign-in redirects here, so it must match the redirect URI
# registered in Google Cloud: <APP_URL>/api/auth/google/callback
APP_URL=http://localhost:3000

# Google OAuth client (Google Cloud Console > Credentials). Keep the real values in .env only.
# Never commit them and never put them in a Docker build argument.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated emails that become admin when they sign in with Google. Verified email only.
ADMIN_EMAILS=

# Email. Locally: Mailpit from docker-compose.yml (`docker compose up -d mailpit`, inbox at
# http://localhost:8025). Production: Mailjet's SMTP relay, with its API key and secret as user
# and password. Leave SMTP_HOST empty to send nothing (tests do this).
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@konnected.no

# Uploaded files (CVs, deliverables, brief attachments) are stored on this server's disk, one
# subdirectory per collection. Default ./media. Must be outside public/ and never served by Caddy
# or any static route: files go out only through /api/<collection>/file/<name>, which checks access.
# In production point it at a mounted volume and include it in the off-server backup.
MEDIA_DIR=./media

# Gotenberg turns filled agreement templates (.docx) into PDFs. Internal network only, never
# exposed. Locally: `docker compose up -d gotenberg` (see docker-compose.yml), port 3400.
GOTENBERG_URL=http://127.0.0.1:3400
