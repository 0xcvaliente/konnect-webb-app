# Copy to .env and edit. .env is ignored by git. Never put real secrets in this file.

# PostgreSQL. These values match docker-compose.yml (local development only).
DATABASE_URL=postgres://konnected:konnected@127.0.0.1:5433/konnected

# Payload secret. Generate your own: openssl rand -hex 32
PAYLOAD_SECRET=replace-with-a-long-random-string
