# Copy to .env and edit. .env is ignored by git. Never put real secrets in this file.

# PostgreSQL. These values match docker-compose.yml (local development only).
DATABASE_URL=postgres://konnected:konnected@127.0.0.1:5433/konnected

# Payload secret. Generate your own: openssl rand -hex 32
PAYLOAD_SECRET=replace-with-a-long-random-string

# The public address of the app. Google sign-in redirects here, so it must match the redirect URI
# registered in Google Cloud: <APP_URL>/api/auth/google/callback
APP_URL=http://localhost:3000

# Google OAuth client (Google Cloud Console > Credentials). Keep the real values in .env only.
# Never commit them and never put them in a Docker build argument.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated emails that become admin when they sign in with Google. Verified email only.
ADMIN_EMAILS=
